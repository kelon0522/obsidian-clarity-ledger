{
  "name": "obsidian-clarity-ledger",
  "version": "0.1.1",
  "description": "《认知觉醒》工字格笔记法的 Obsidian 插件",
  "license": "MIT",
  "keywords": [
    "obsidian-plugin",
    "productivity",
    "daily-planning",
    "markdown"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs watch",
    "dev:css": "vite build --config vite.css.config.mts --watch",
    "build": "npm run build:css && tsc --noEmit -p tsconfig.json && node esbuild.config.mjs production && node scripts/verify-build.mjs",
    "build:css": "vite build --config vite.css.config.mts && node scripts/move-css.mjs",
    "build:js": "tsc --noEmit -p tsconfig.json && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:bat": "node scripts/check-bat.mjs",
    "test": "node scripts/test.mjs",
    "test:watch": "vitest",
    "mutation": "node scripts/mutation.mjs",
    "lock:fix": "node scripts/fix-lock-optional.mjs",
    "version": "node -e \"const fs=require('fs'),m=require('./manifest.json'),p=require('./package.json');m.version=p.version;fs.writeFileSync('manifest.json',JSON.stringify(m,null,2)+'\\n');const v=require('./versions.json');v[p.version]=m.minAppVersion;fs.writeFileSync('versions.json',JSON.stringify(v,null,2)+'\\n')\" && git add manifest.json versions.json && git commit -m \"chore: v\"",
    "postversion": "node scripts/fix-tag.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.24.0",
    "jsdom": "^30.1.2",
    "obsidian": "^1.7.2",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
